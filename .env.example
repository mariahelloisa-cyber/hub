# Copie este arquivo para .env e preencha com os valores do seu projeto Lovable Cloud / Supabase
# Estas variáveis são públicas (prefixo VITE_) e usadas no client.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
